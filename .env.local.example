# From your Supabase project's Settings -> API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by app/api/* route handlers
# that need to bypass RLS (invoice generation, document matching, cron).
SUPABASE_SERVICE_ROLE_KEY=

# Plain SMTP for the notification cron's email channel — the same Gmail
# app password already set up for Supabase Auth's SMTP works fine here.
# Leave unset to run with email notifications skipped (in-app still works).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared secret the cron caller must send as `Authorization: Bearer <value>`
# when hitting /api/cron/notify. Generate any random string.
# Vercel Cron (vercel.json) sends Authorization: Bearer <CRON_SECRET> if you
# set CRON_SECRET in the Vercel project env (configure CRON_SECRET matching).
CRON_SECRET=
